# FastAPI 服务模板 - 环境变量配置示例
# 复制此文件为 .env 并根据你的环境修改相应的值

# ==========================================
# 应用基本配置
# ==========================================
APP_NAME=FastAPI 服务模板
APP_VERSION=1.0.0
DEBUG=True

# ==========================================
# 服务器配置
# ==========================================
HOST=127.0.0.1
PORT=8000
RELOAD=True

# ==========================================
# JWT 认证配置
# ==========================================
# 重要：生产环境中请使用强密码！
# 可以使用以下命令生成安全的密钥：
# openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# 数据库配置
# ==========================================
# PostgreSQL 数据库连接 URL
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://fastapi_user:fastapi_password@localhost:5432/fastapi_db

# 测试数据库连接 URL
TEST_DATABASE_URL=postgresql+asyncpg://fastapi_user:fastapi_password@localhost:5432/fastapi_test_db

# ==========================================
# 数据库连接池配置
# ==========================================
# 连接池大小
DB_POOL_SIZE=10
# 连接池最大溢出数量
DB_MAX_OVERFLOW=20
# 连接池超时时间（秒）
DB_POOL_TIMEOUT=30

# ==========================================
# 可选配置（高级功能）
# ==========================================

# Redis 配置（如果使用缓存）
# REDIS_URL=redis://localhost:6379/0

# 邮件服务配置（如果需要发送邮件）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_TLS=True

# 文件上传配置
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=10485760  # 10MB

# 日志配置
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# CORS 配置
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# API 限流配置
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60  # 秒

# 监控配置
# SENTRY_DSN=your-sentry-dsn-here

# ==========================================
# 生产环境特定配置
# ==========================================
# 在生产环境中，请确保：
# 1. DEBUG=False
# 2. RELOAD=False
# 3. 使用强密码的 SECRET_KEY
# 4. 使用 HTTPS
# 5. 配置适当的 CORS 源
# 6. 设置合适的日志级别

# 生产环境示例：
# DEBUG=False
# RELOAD=False
# HOST=0.0.0.0
# SECRET_KEY=your-production-secret-key-generated-with-openssl
# DATABASE_URL=postgresql+asyncpg://prod_user:strong_password@db_host:5432/prod_db